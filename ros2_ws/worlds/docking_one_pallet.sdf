<?xml version="1.0"?>
<sdf version="1.9"><world name="warehouse">
<physics name="dock_physics" type="dart"><max_step_size>0.005</max_step_size><real_time_factor>1</real_time_factor><dart><collision_detector>bullet</collision_detector></dart></physics>
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre</render_engine></plugin>
<plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
<gui fullscreen="false"><plugin name="3D View" filename="GzScene3D"><engine>ogre2</engine><scene>scene</scene><camera_pose>-2.2 -2.8 2.1 0 0.38 0.7</camera_pose></plugin><plugin name="World control" filename="WorldControl"><play_pause>1</play_pause><start_paused>0</start_paused></plugin></gui>
<gravity>0 0 -9.81</gravity><scene><ambient>0.6 0.6 0.6 1</ambient><background>0.7 0.7 0.7 1</background><shadows>false</shadows></scene>
<light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.4 0.2 -0.9</direction></light>
<model name="ground_plane"><static>true</static><link name="ground"><collision name="ground"><geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry></collision><visual name="ground"><geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry><material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual></link></model>
<!-- Square 35.5 cm top; 5 cm corner legs leave a 25.5 cm front opening. Top underside is 10 cm above floor. -->
<model name="single_floor_pallet"><static>false</static><pose>2 0.10 0 0 0 0</pose>
<plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_model_pose>true</publish_model_pose><use_pose_vector_msg>false</use_pose_vector_msg><update_frequency>20</update_frequency><topic>/pallet/pose</topic></plugin>
<link name="pallet"><inertial><mass>1.0</mass><inertia><ixx>0.0115</ixx><iyy>0.0115</iyy><izz>0.021</izz></inertia></inertial>
<collision name="top_collision"><pose>0 0 0.105 0 0 0</pose><geometry><box><size>0.355 0.355 0.01</size></box></geometry></collision><visual name="top_visual"><pose>0 0 0.105 0 0 0</pose><geometry><box><size>0.355 0.355 0.01</size></box></geometry><material><ambient>0.03 0.19 0.72 1</ambient><diffuse>0.04 0.27 0.90 1</diffuse></material></visual><collision name="front_left_leg_collision"><pose>-0.1525 0.1525 0.05 0 0 0</pose><geometry><box><size>0.05 0.05 0.1</size></box></geometry></collision><visual name="front_left_leg_visual"><pose>-0.1525 0.1525 0.05 0 0 0</pose><geometry><box><size>0.05 0.05 0.1</size></box></geometry><material><ambient>0.03 0.19 0.72 1</ambient><diffuse>0.04 0.27 0.90 1</diffuse></material></visual><collision name="front_right_leg_collision"><pose>-0.1525 -0.1525 0.05 0 0 0</pose><geometry><box><size>0.05 0.05 0.1</size></box></geometry></collision><visual name="front_right_leg_visual"><pose>-0.1525 -0.1525 0.05 0 0 0</pose><geometry><box><size>0.05 0.05 0.1</size></box></geometry><material><ambient>0.03 0.19 0.72 1</ambient><diffuse>0.04 0.27 0.90 1</diffuse></material></visual><collision name="back_left_leg_collision"><pose>0.1525 0.1525 0.05 0 0 0</pose><geometry><box><size>0.05 0.05 0.1</size></box></geometry></collision><visual name="back_left_leg_visual"><pose>0.1525 0.1525 0.05 0 0 0</pose><geometry><box><size>0.05 0.05 0.1</size></box></geometry><material><ambient>0.03 0.19 0.72 1</ambient><diffuse>0.04 0.27 0.90 1</diffuse></material></visual><collision name="back_right_leg_collision"><pose>0.1525 -0.1525 0.05 0 0 0</pose><geometry><box><size>0.05 0.05 0.1</size></box></geometry></collision><visual name="back_right_leg_visual"><pose>0.1525 -0.1525 0.05 0 0 0</pose><geometry><box><size>0.05 0.05 0.1</size></box></geometry><material><ambient>0.03 0.19 0.72 1</ambient><diffuse>0.04 0.27 0.90 1</diffuse></material></visual></link></model></world></sdf>
